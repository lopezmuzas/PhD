# Cómputo local de laboratorio (se mantienen las carpetas vacías con .gitkeep si existen)
labs/dl-lab/outputs/runs/*
labs/dl-lab/outputs/checkpoints/*
!labs/dl-lab/outputs/runs/.gitkeep
!labs/dl-lab/outputs/checkpoints/.gitkeep
