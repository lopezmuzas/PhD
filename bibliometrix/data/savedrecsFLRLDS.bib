@inproceedings{ WOS:000900064900015,
Author = {Jin, Jiayin and Ren, Jiaxiang and Zhou, Yang and Lyu, Lingjuan and Liu,
   Ji and Dou, Dejing},
Editor = {Chaudhuri, K and Jegelka, S and Song, L and Szepesvari, C and Niu, G and Sabato, S},
Title = {Accelerated Federated Learning with Decoupled Adaptive Optimization},
Booktitle = {INTERNATIONAL CONFERENCE ON MACHINE LEARNING, VOL 162},
Series = {Proceedings of Machine Learning Research},
Year = {2022},
Pages = {10298-10322},
Note = {39th International Conference on Machine Learning (ICML), Baltimore, MD,
   JUL 17-23, 2022},
Abstract = {The federated learning (FL) framework enables edge clients to
   collaboratively learn a shared inference model while keeping privacy of
   training data on clients. Recently, many heuristics efforts have been
   made to generalize centralized adaptive optimization methods, such as
   SGDM, Adam, AdaGrad, etc., to federated settings for improving
   convergence and accuracy. However, there is still a paucity of
   theoretical principles on where to and how to design and utilize
   adaptive optimization methods in federated settings. This work aims to
   develop novel adaptive optimization methods for FL from the perspective
   of dynamics of ordinary differential equations (ODEs). First, an
   analytic framework is established to build a connection between
   federated optimization methods and decompositions of ODEs of
   corresponding centralized optimizers. Second, based on this analytic
   framework, a momentum decoupling adaptive optimization method, FEDDA, is
   developed to fully utilize the global momentum on each local iteration
   and accelerate the training convergence. Last but not least, full batch
   gradients are utilized to mimic centralized optimization in the end of
   the training process to ensure the convergence and overcome the possible
   inconsistency caused by adaptive optimization methods.},
