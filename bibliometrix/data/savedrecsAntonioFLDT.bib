@article{ WOS:001756704100001,
Author = {Wooller, Sarah K. and Blake, Andrew and McCabe, Martin and McLean, Colin
   and Price, Gareth and Unsworth, Harriet and Van Hemelrijck, Mieke and
   Pearl, Frances M. G.},
Title = {From bench to byte: A UK perspective on data-driven cancer research},
Journal = {EUROPEAN JOURNAL OF CANCER},
