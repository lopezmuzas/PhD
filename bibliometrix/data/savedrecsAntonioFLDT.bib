@inproceedings{ WOS:000903586400040,
Author = {Han, Sungwon and Park, Sungwon and Wu, Fangzhao and Kim, Sundong and Wu,
   Chuhan and Xie, Xing and Cha, Meeyoung},
Editor = {Avidan, S and Brostow, G and Cisse, M and Farinella, GM and Hassner, T},
Title = {FedX: Unsupervised Federated Learning with Cross Knowledge Distillation},
Booktitle = {COMPUTER VISION - ECCV 2022, PT XXX},
