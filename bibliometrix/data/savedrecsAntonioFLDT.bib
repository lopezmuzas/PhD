@inproceedings{ WOS:001585629200005,
Author = {Dalmolen, Simon and van Hillegersberg, Jos and Moonen, Hans and
   Cornelisse, Erik and Bouwman, Jildau and Boorsma, Andre},
Editor = {Schreieck, M and Oshri, I and Kotlarsky, J and Krancher, O},
Title = {Common European Data Spaces in Health Care: A Privacy-Preserving
   Ecosystem for Cancer Research},
Booktitle = {BRIDGING DIGITAL SOURCING, PLATFORMS, AND ECOSYSTEMS, DSPE 2025},
Series = {Lecture Notes in Business Information Processing},
Year = {2026},
Volume = {563},
