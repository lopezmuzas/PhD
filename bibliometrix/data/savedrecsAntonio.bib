   Zhu, Hangyu; Liu, Shiqing; Jin, Yaochu, Univ Surrey, Dept Comp Sci, Guildford GU2 7XH, Surrey, England.
   Xu, Jinjin, East China Univ Sci Technol, Key Lab Smart Mfg Energy Chem Proc, Minist Educ, Shanghai 200237, Peoples R China.},
DOI = {10.1016/j.neucom.2021.07.098},
EarlyAccessDate = {SEP 2021},
ISSN = {0925-2312},
