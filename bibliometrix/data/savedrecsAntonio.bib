@inproceedings{ WOS:001567374700094,
Author = {Vatsavai, Ranga Raju and Symons, Chris},
Editor = {Paul, R},
Title = {Federated Clustering With Heterogeneous Distributed Data},
Booktitle = {2025 IEEE WORLD AI IOT CONGRESS, AIIOT},
Year = {2025},
Pages = {654-660},
Note = {6th WORLD AI IoT Congress-AIIoT-Annual, Seattle, WA, MAY 28-30, 2025},
Abstract = {Federated learning has emerged as a prominent framework for distributed
   machine learning, addressing data privacy concerns as well as the
   challenges of decentralized data storage. Unlike centralized approaches,
   real-world distributed datasets often face two challenges: first, they
   violate the independent and identically distributed (IID) assumption,
   and second, they usually lack sufficient labeled data for supervised
   learning. To overcome these limitations, we propose an unsupervised
   federated K-means clustering algorithm designed for non-IID data
   environments. Our experimental validation demonstrates that the proposed
   method achieves performance comparable to centralized K-means clustering
   while preserving data locality.},
