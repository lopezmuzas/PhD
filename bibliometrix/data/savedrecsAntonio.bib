@inproceedings{ WOS:000870759101043,
Author = {Mendieta, Matias and Yang, Taojiannan and Wang, Pu and Lee, Minwoo and
   Ding, Zhengming and Chen, Chen},
Book-Group-Author = {IEEE COMP SOC},
Title = {Local Learning Matters: Rethinking Data Heterogeneity in Federated
   Learning},
Booktitle = {2022 IEEE/CVF CONFERENCE ON COMPUTER VISION AND PATTERN RECOGNITION
   (CVPR)},
Series = {IEEE Conference on Computer Vision and Pattern Recognition},
Year = {2022},
