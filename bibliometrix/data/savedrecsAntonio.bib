Title = {WHEN GREEN LEARNING MEETS FEDERATED LEARNING: TOWARD DISTRIBUTED
   LEARNING WITH LOW COMPLEXITY AND MODEL HETEROGENEITY},
Booktitle = {2024 IEEE INTERNATIONAL CONFERENCE ON ACOUSTICS, SPEECH AND SIGNAL
