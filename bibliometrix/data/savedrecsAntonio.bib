@inproceedings{ WOS:000893639100090,
Author = {Nagalapatti, Lokesh and Mittal, Ruhi Sharma and Narayanam, Ramasuri},
Book-Group-Author = {Assoc Advancement Artificial Intelligence},
Title = {Is Your Data Relevant?: Dynamic Selection of Relevant Data for Federated
   Learning},
Booktitle = {THIRTY-SIXTH AAAI CONFERENCE ON ARTIFICIAL INTELLIGENCE / THIRTY-FOURTH
   CONFERENCE ON INNOVATIVE APPLICATIONS OF ARTIFICIAL INTELLIGENCE /
   TWELVETH SYMPOSIUM ON EDUCATIONAL ADVANCES IN ARTIFICIAL INTELLIGENCE},
Series = {AAAI Conference on Artificial Intelligence},
Year = {2022},
Pages = {7859-7867},
Note = {36th AAAI Conference on Artificial Intelligence / 34th Conference on
   Innovative Applications of Artificial Intelligence / 12th Symposium on
   Educational Advances in Artificial Intelligence, ELECTR NETWORK, FEB
   22-MAR 01, 2022},
Abstract = {Federated Learning (FL) is a machine learning paradigm in which multiple
   clients participate to collectively learn a global machine learning
   model at the central server. Clients share updates derived from their
   local data to the server such that their privacy is not compromised. The
   server aggregates these updates and applies it to the global model. It
   is plausible that not all the data owned by each client is relevant to
   the server's learning objective. The updates incorporated from
   irrelevant data could be detrimental to the global model. The task of
   selecting relevant data is explored in traditional machine learning
   settings where the assumption is that all the data is available in one
   place. In FL settings, the data is distributed across multiple clients
   and the server can't introspect it. This precludes the application of
   traditional solutions to selecting relevant data here. In this paper, we
   propose an approach called Federated Learning with Relevant Data (FLRD),
   that facilitates clients to derive updates using relevant data. Each
   client learns a model called Relevant Data Selector (RDS) that is
   private to itself to do the selection. This in turn helps in building an
   effective global model. We perform experiments with multiple real-world
   datasets to demonstrate the efficacy of our solution. The results show
   (a) the capability of FLRD to identify relevant data samples at each
   client locally and (b) the superiority of the global model learned by
   FLRD over other baseline algorithms.},
